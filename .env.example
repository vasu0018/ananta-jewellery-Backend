# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of this API (used to build absolute media URLs in emails/PDFs)
API_PUBLIC_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:3005
ADMIN_URL=http://localhost:3006
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3005,http://localhost:3006

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ananta_jewellery?schema=public

# ── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# true behind HTTPS in production
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Razorpay (leave empty to use mock payments in development) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (leave SMTP_HOST empty to log emails to console) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ananta Jewellery <hello@anantajewellery.in>"

# ── Storage ───────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Seed ──────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@anantajewellery.in
SEED_ADMIN_PASSWORD=Admin@123
